# PantryMind — copy to .env and fill in. Never commit .env.

# ---- AWS ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Bedrock ----
# Agent IDs come from the Bedrock console after the agent is created (Phase 2)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
# Titan Text Embeddings V2 outputs 1024 dims — must match VECTOR(1024) in schema.sql
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- CockroachDB Cloud ----
# From `ccloud cluster sql pantrymind --output json` (Phase 1)
DATABASE_URL=postgresql://user:password@host:26257/pantrymind?sslmode=verify-full

# ---- CockroachDB Managed MCP Server ----
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=

# ---- S3 ----
S3_BUCKET=

# ---- External recipe API ----
SPOONACULAR_API_KEY=

# ---- Demo ----
# Single hardcoded user for the demo; memory recall is scoped to this handle
DEMO_USER_HANDLE=demo
