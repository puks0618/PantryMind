# PantryMind — copy to .env and fill in. Never commit .env.

# ---- AWS ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Bedrock ----
# Agent IDs come from the Bedrock console after the agent is created (Phase 2)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
# Titan Text Embeddings V2 outputs 1024 dims — must match VECTOR(1024) in schema.sql
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# NOTE for A14 (Bedrock Agent creation): current-gen Claude models (Sonnet 4.5+,
# Opus 4.5+) are NOT invocable on-demand in this account/region — they require a
# cross-region inference profile ID, e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0
# (verified working 2026-08-17). Confirm access via:
#   aws bedrock list-inference-profiles --region $AWS_REGION
# The Bedrock Agent console model picker handles this automatically; only matters
# if the agent is ever driven via raw InvokeModel instead of the Agent API.

# ---- CockroachDB Cloud ----
# From `ccloud cluster sql pantrymind --output json` (Phase 1)
DATABASE_URL=postgresql://user:password@host:26257/pantrymind?sslmode=verify-full

# ---- CockroachDB Managed MCP Server ----
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=

# ---- S3 ----
S3_BUCKET=pantrymind-demo-assets-361769562408

# ---- External recipe API ----
SPOONACULAR_API_KEY=

# ---- Demo ----
# Single hardcoded user for the demo; memory recall is scoped to this handle
DEMO_USER_HANDLE=demo
